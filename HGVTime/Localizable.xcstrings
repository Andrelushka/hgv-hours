    "Restoring replaces everything on this iPhone with the backup. Make a backup of this phone first if you might need it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócenie zastąpi wszystko na tym iPhonie kopią. Jeśli może Ci się przydać, najpierw zrób kopię tego telefonu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurarea înlocuiește tot de pe acest iPhone cu backupul. Fă întâi un backup al acestui telefon dacă ți-ar putea trebui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление заменит всё на этом iPhone резервной копией. Если это может понадобиться, сначала сделайте копию этого телефона."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлення замінить усе на цьому iPhone резервною копією. Якщо це може знадобитися, спершу зробіть копію цього телефона."
          }
        }
      }
    },
