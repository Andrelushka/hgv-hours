    "Keep the screen on": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wygaszaj ekranu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține ecranul aprins"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не гасить экран"
          }
        },
        "uk": {
