    "Search by postcode and pick the address from the list, type it yourself, or pinpoint the exact gate or bay on the map.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj po kodzie pocztowym i wybierz adres z listy, wpisz go sam lub wskaż dokładną bramę lub rampę na mapie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută după codul poștal și alege adresa din listă, scrie-o singur sau indică poarta ori rampa exactă pe hartă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите по индексу и выберите адрес из списка, введите его сами или отметьте точные ворота или рампу на карте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдіть за індексом і виберіть адресу зі списку, введіть її самі або позначте точні ворота чи рампу на мапі."
          }
        }
      }
    },
    "Search postcode, address or company": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj kodu, adresu lub firmy"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută cod poștal, adresă sau firmă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск по индексу, адресу или компании"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук за індексом, адресою чи компанією"
          }
        }
      }
    },
    "Search the depot postcode and pick the address, type it, or pinpoint it on the map. The route on the map starts here.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj kod pocztowy bazy i wybierz adres, wpisz go lub wskaż na mapie. Trasa na mapie zaczyna się tutaj."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută codul poștal al depoului și alege adresa, scrie-o sau indic-o pe hartă. Traseul de pe hartă pornește de aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите индекс базы и выберите адрес, введите его или отметьте на карте. Маршрут на карте начинается отсюда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдіть індекс бази й виберіть адресу, введіть її або позначте на мапі. Маршрут на мапі починається звідси."
          }
        }
      }
    },
