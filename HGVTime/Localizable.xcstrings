    },
    "Licence categories, e.g. C, C+E": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie prawa jazdy, np. C, C+E"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorii de permis, de ex. C, C+E"
          }
        },
        "ru": {
          "stringUnit": {
