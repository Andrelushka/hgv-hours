    "Activities that run past midnight are shortened, not deleted. This can't be undone.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czynności trwające po północy są skracane, a nie usuwane. Tego nie można cofnąć."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activitățile care trec de miezul nopții sunt scurtate, nu șterse. Nu se poate anula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активности, идущие после полуночи, укорачиваются, а не удаляются. Это нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активності, що тривають після опівночі, скорочуються, а не видаляються. Це не можна скасувати."
          }
        }
      }
    },
