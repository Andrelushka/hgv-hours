    "Shifts you record on the Today tab appear here, grouped by week.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany zapisane w karcie „Dziś” pojawią się tutaj, pogrupowane według tygodni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Turele înregistrate în fila „Azi” apar aici, grupate pe săptămâni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смены, записанные во вкладке «Сегодня», появятся здесь, сгруппированные по неделям."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни, записані у вкладці «Сьогодні», з'являться тут, згруповані за тижнями."
          }
        }
      }
    },
