    "Pay settings are in the Earnings tab (⚙︎). Vehicles, fuel and lookups are in the Jobs tab (⚙︎).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia płac są w karcie „Zarobki” (⚙︎). Pojazdy, paliwo i wyszukiwanie — w karcie „Zlecenia” (⚙︎)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setările de plată sunt în fila „Câștiguri” (⚙︎). Vehiculele, combustibilul și căutările sunt în fila „Curse” (⚙︎)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки оплаты — во вкладке «Заработок» (⚙︎). Машины, топливо и поиск — во вкладке «Работы» (⚙︎)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
