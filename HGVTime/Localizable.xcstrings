    "To cancel a single drop or collection, use ⋯ on that stop in Today's job.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby anulować pojedynczy rozładunek lub odbiór, użyj ⋯ przy tym przystanku w „Dzisiejsze zlecenie”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să anulezi o singură livrare sau ridicare, folosește ⋯ la oprirea respectivă din „Cursa de azi”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отменить одну выгрузку или загрузку, нажмите ⋯ у этой остановки в «Работа сегодня»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб скасувати одне вивантаження чи забір, натисніть ⋯ біля цієї зупинки в «Робота сьогодні»."
          }
        }
      }
    },
    "To get alerts while driving, allow HGV Hours in iPhone Settings → Focus → Driving → Apps.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dostawać alerty podczas jazdy, zezwól HGV Hours w Ustawienia iPhone'a → Skupienie → Prowadzenie → Aplikacje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să primești alerte la volan, permite HGV Hours în Configurări iPhone → Concentrare → Condus → Aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы получать оповещения за рулём, разрешите HGV Hours в Настройки iPhone → Фокусирование → Вождение → Приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб отримувати сповіщення за кермом, дозвольте HGV Hours у Параметри iPhone → Зосередження → Водіння → Програми."
          }
        }
      }
    },
    "To keep it in your records instead, mark it cancelled, failed or rejected.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zachować go w zapisach, oznacz go jako anulowany, nieudany lub odrzucony."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca s-o păstrezi în evidențe, marcheaz-o ca anulată, eșuată sau respinsă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы сохранить её в записях, отметьте её отменённой, невыполненной или отклонённой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб зберегти її в записах, позначте її скасованою, невиконаною або відхиленою."
          }
        }
      }
    },
