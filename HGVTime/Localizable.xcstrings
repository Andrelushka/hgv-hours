    "This can't be undone": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego nie można cofnąć"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se poate anula"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не можна скасувати"
          }
        }
      }
    },
    "This shift: %@ loaded · %@ empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This shift: %1$@ loaded · %2$@ empty"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta zmiana: z ładunkiem %@ · pusto %@"
          }
        },
        "ro": {
