    "No job planned in the next 36 hours. Add one in the Jobs tab and the alarm is set for it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zleceń w ciągu najbliższych 36 godzin. Dodaj je w karcie Zlecenia, a budzik ustawi się na nie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio cursă planificată în următoarele 36 de ore. Adaugă una în fila Curse și alarma se setează pentru ea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ближайшие 36 часов работ не запланировано. Добавьте работу во вкладке «Работы», и будильник поставится на неё."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У найближчі 36 годин робіт не заплановано. Додайте роботу у вкладці «Роботи», і будильник поставиться на неї."
          }
        }
      }
    },
    "No matches yet — keep typing, or fill in below.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wyników — pisz dalej lub uzupełnij poniżej."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nimic — continuă să scrii sau completează mai jos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет совпадений — продолжайте вводить или заполните ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки немає збігів — продовжуйте вводити або заповніть нижче."
          }
        }
      }
    },
    "No more than 56 hours of driving in a fixed week (Monday 00:00 to Sunday 24:00).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie więcej niż 56 godzin jazdy w tygodniu stałym (od poniedziałku 00:00 do niedzieli 24:00)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult 56 de ore de condus într-o săptămână fixă (de luni 00:00 până duminică 24:00)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не более 56 часов вождения за фиксированную неделю (с понедельника 00:00 до воскресенья 24:00)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не більше 56 годин водіння за фіксований тиждень (з понеділка 00:00 до неділі 24:00)."
          }
        }
      }
    },
    "No more than 60 hours of working time in any week. Driving and other work count; POA and breaks don't.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie więcej niż 60 godzin czasu pracy w dowolnym tygodniu. Jazda i inna praca się liczą; POA i przerwy nie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult 60 de ore de timp de lucru în orice săptămână. Condusul și altă muncă se numără; POA și pauzele nu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не более 60 часов рабочего времени за любую неделю. Вождение и другая работа считаются; POA и перерывы — нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не більше 60 годин робочого часу за будь-який тиждень. Водіння й інша робота рахуються; POA й перерви — ні."
          }
        }
      }
    },
    "No more than 90 hours of driving in any two consecutive fixed weeks.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie więcej niż 90 godzin jazdy w dowolnych dwóch kolejnych tygodniach stałych."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel mult 90 de ore de condus în oricare două săptămâni fixe consecutive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не более 90 часов вождения за любые две подряд фиксированные недели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не більше 90 годин водіння за будь-які два поспіль фіксовані тижні."
          }
        }
      }
    },
