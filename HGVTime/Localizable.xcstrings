    "Shift starts and ends, activity changes, card in/out, stops, fuel, overspeed and infringements are logged here with where they happened.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Początki i końce zmian, zmiany czynności, włożenie/wyjęcie karty, przystanki, paliwo, przekroczenia prędkości i naruszenia są tu zapisywane razem z miejscem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începuturile și sfârșiturile de tură, schimbările de activitate, cardul introdus/scos, opririle, combustibilul, vitezele excesive și încălcările se înregistrează aici împreună cu locul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начало и конец смен, смены активности, вставка/извлечение карты, остановки, топливо, превышения и нарушения записываются здесь вместе с местом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Початок і кінець змін, зміни активності, вставлення/вилучення картки, зупинки, пальне, перевищення й порушення записуються тут разом із місцем."
          }
        }
      }
    },
