    "Backup from %@ (app %@): %lld activities, %lld plans, %lld vehicles, %lld notes. Everything currently on this iPhone will be replaced. This can't be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Backup from %1$@ (app %2$@): %3$lld activities, %4$lld plans, %5$lld vehicles, %6$lld notes. Everything currently on this iPhone will be replaced. This can't be undone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia z %@ (aplikacja %@): czynności %lld, planów %lld, pojazdów %lld, notatek %lld. Wszystko, co jest teraz na tym iPhonie, zostanie zastąpione. Tego nie można cofnąć."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup din %@ (aplicația %@): %lld activități, %lld planuri, %lld vehicule, %lld notițe. Tot ce e acum pe acest iPhone va fi înlocuit. Nu se poate anula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия от %@ (приложение %@): активностей %lld, планов %lld, машин %lld, заметок %lld. Всё, что сейчас на этом iPhone, будет заменено. Это нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервна копія від %@ (застосунок %@): активностей %lld, планів %lld, машин %lld, нотаток %lld. Усе, що зараз на цьому iPhone, буде замінено. Це не можна скасувати."
          }
        }
      }
    },
