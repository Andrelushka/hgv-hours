    "Saved on your iPhone and shown on the map; you'll be warned when you come this way again.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane na iPhonie i pokazane na mapie; dostaniesz ostrzeżenie, gdy znów będziesz tędy jechać."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvat pe iPhone și afișat pe hartă; vei fi avertizat când treci iar pe aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется на iPhone и показывается на карте; вы получите предупреждение, когда снова будете здесь проезжать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається на iPhone й показується на мапі; ви отримаєте попередження, коли знову проїжджатимете тут."
          }
        }
      }
    },
