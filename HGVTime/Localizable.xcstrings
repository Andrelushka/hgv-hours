    "Share by email, AirDrop, Files or WhatsApp. CSV opens in Excel, Numbers and Google Sheets.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij e-mailem, AirDropem, w Plikach lub WhatsAppie. CSV otwiera się w Excelu, Numbers i Arkuszach Google."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuie prin e-mail, AirDrop, Fișiere sau WhatsApp. CSV se deschide în Excel, Numbers și Google Sheets."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте по почте, AirDrop, в Файлы или WhatsApp. CSV открывается в Excel, Numbers и Google Таблицах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішліть поштою, AirDrop, у Файли чи WhatsApp. CSV відкривається в Excel, Numbers і Google Таблицях."
          }
        }
      }
    },
