    "Break / rest": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwa / odpoczynek"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauză / odihnă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перерыв / отдых"
          }
        },
        "uk": {
