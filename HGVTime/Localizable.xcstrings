    "Other activities that overlap these times are shortened or removed so the day adds up.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne czynności nachodzące na te godziny są skracane lub usuwane, by dzień się zgadzał."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte activități care se suprapun cu aceste ore sunt scurtate sau eliminate ca ziua să se potrivească."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие активности, перекрывающие это время, укорачиваются или удаляются, чтобы день сходился."
          }
        },
        "uk": {
