    "Normally 9 hours of driving between daily rests. Twice a week you may drive 10 hours.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykle 9 godzin jazdy między odpoczynkami dziennymi. Dwa razy w tygodniu możesz jechać 10 godzin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În mod normal 9 ore de condus între odihnele zilnice. De două ori pe săptămână poți conduce 10 ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно 9 часов вождения между ежедневными отдыхами. Дважды в неделю можно ехать 10 часов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвичай 9 годин водіння між щоденними відпочинками. Двічі на тиждень можна їхати 10 годин."
          }
        }
      }
    },
