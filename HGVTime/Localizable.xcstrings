    "Set leave time myself": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sam ustaw czas wyjazdu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setez singur ora plecării"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задать время выезда самому"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задати час виїзду самому"
          }
        }
      }
    },
    "Set to Off (0) to switch off. Paid hours past either threshold count as overtime.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw Wył. (0), aby wyłączyć. Płatne godziny powyżej któregokolwiek progu liczą się jako nadgodziny."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune Oprit (0) ca să dezactivezi. Orele plătite peste oricare prag se numără ca ore suplimentare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте Выкл. (0), чтобы отключить. Оплачиваемые часы сверх любого порога считаются сверхурочными."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте Вимк. (0), щоб вимкнути. Оплачувані години понад будь-який поріг вважаються понаднормовими."
          }
        }
      }
    },
    "Set up a passcode on this iPhone to use the app lock.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw kod na tym iPhonie, aby używać blokady aplikacji."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează un cod de acces pe acest iPhone ca să folosești blocarea aplicației."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите код-пароль на этом iPhone, чтобы использовать блокировку приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Установіть код-пароль на цьому iPhone, щоб використовувати блокування застосунку."
          }
        }
      }
    },
    "Set up shift checks": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw kontrole zmiany"
          }
        },
        "ro": {
