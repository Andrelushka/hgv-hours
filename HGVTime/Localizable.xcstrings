    "Tile order and hidden tiles, date style, miles and feet": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejność i ukryte kafelki, format daty, mile i stopy"
          }
        },
        "ro": {
