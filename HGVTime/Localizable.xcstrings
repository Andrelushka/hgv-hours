    "Start a shift on the Today tab and your driving, working time and rest limits appear here.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij zmianę w karcie „Dziś”, a tutaj pojawią się limity jazdy, czasu pracy i odpoczynku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe o tură în fila „Azi” și aici apar limitele de condus, timp de lucru și odihnă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните смену во вкладке «Сегодня», и здесь появятся лимиты вождения, рабочего времени и отдыха."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть зміну у вкладці «Сьогодні», і тут з'являться ліміти водіння, робочого часу й відпочинку."
          }
        }
      }
    },
