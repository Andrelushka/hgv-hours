    "Example: %@. Odometer readings use the main unit only.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przykład: %@. Odczyty licznika tylko w głównej jednostce."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplu: %@. Citirile de kilometraj folosesc doar unitatea principală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример: %@. Показания одометра — только в основной единице."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приклад: %@. Показання одометра — лише в основній одиниці."
          }
        }
      }
    },
    "Example: %@. UK bridge signs show both; height warnings always compare in metres.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przykład: %@. Brytyjskie znaki przy mostach podają obie; ostrzeżenia o wysokości zawsze porównują w metrach."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplu: %@. Indicatoarele britanice de la poduri arată ambele; avertizările de înălțime compară mereu în metri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример: %@. На британских знаках у мостов указаны обе; предупреждения о высоте всегда сравниваются в метрах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приклад: %@. На британських знаках біля мостів указано обидві; попередження про висоту завжди порівнюються в метрах."
          }
        }
      }
    },
