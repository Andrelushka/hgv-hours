    "Once a week": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz w tygodniu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O dată pe săptămână"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в неделю"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на тиждень"
          }
        }
      }
    },
    "One file with all your shifts, plans, vehicles, notes, pay items, events, routes, reminders and settings. Save it to Files or iCloud Drive, AirDrop it, or email it to yourself. Keep it private — it holds your work records.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden plik ze wszystkimi zmianami, planami, pojazdami, notatkami, płacami, zdarzeniami, trasami, przypomnieniami i ustawieniami. Zapisz go w Plikach lub iCloud Drive, wyślij przez AirDrop albo e-mailem do siebie. Trzymaj go prywatnie — zawiera Twoje zapisy pracy."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singur fișier cu toate turele, planurile, vehiculele, notițele, plățile, evenimentele, traseele, mementourile și setările. Salvează-l în Fișiere sau iCloud Drive, trimite-l prin AirDrop sau pe e-mail ție însuți. Păstrează-l privat — conține evidențele tale de muncă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один файл со всеми сменами, планами, машинами, заметками, оплатой, событиями, маршрутами, напоминаниями и настройками. Сохраните в Файлы или iCloud Drive, отправьте по AirDrop или себе на почту. Храните его приватно — в нём ваши рабочие записи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один файл з усіма змінами, планами, машинами, нотатками, оплатою, подіями, маршрутами, нагадуваннями й налаштуваннями. Збережіть у Файли чи iCloud Drive, надішліть через AirDrop або собі на пошту. Зберігайте його приватно — у ньому ваші робочі записи."
          }
        }
      }
    },
