    "Check the height plate in the cab. Height shows on the Today screen as a reminder for low bridges.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź tabliczkę wysokości w kabinie. Wysokość jest widoczna na ekranie „Dziś” jako przypomnienie o niskich mostach."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică plăcuța de înălțime din cabină. Înălțimea apare pe ecranul „Azi” ca memento pentru podurile joase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте табличку высоты в кабине. Высота показывается на экране «Сегодня» как напоминание о низких мостах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте табличку висоти в кабіні. Висота показується на екрані «Сьогодні» як нагадування про низькі мости."
          }
        }
      }
    },
